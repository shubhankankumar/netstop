{
  "manifest_version": 3,
  "name": "NetStop",
  "version": "1.0.0",
  "description": "What your laptop sent and received today, from the NetStop recorder.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "action": { "default_popup": "popup.html", "default_title": "NetStop: today's traffic" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
